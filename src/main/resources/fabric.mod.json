{
  "schemaVersion": 1,
  "id": "venuesound",
  "version": "${version}",
  "name": "VenueSound",
  "description": "A full venue sound system: wireless microphones, receivers, a mixing console and PA speakers, built on Simple Voice Chat.",
  "authors": ["TonyD365"],
  "contact": {
    "sources": "https://github.com/TonyD365/venue-sound",
    "issues": "https://github.com/TonyD365/venue-sound/issues"
  },
  "license": "MIT",
  "icon": "assets/venuesound/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.tonyd365.venuesound.VenueSound"],
    "client": ["dev.tonyd365.venuesound.client.VenueSoundClient"],
    "voicechat": ["dev.tonyd365.venuesound.VenueSoundVoicechatPlugin"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "voicechat": ">=1.20.1-2.5.0"
  }
}
